{
  "name": "smartcart",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "dev": "npm run dev --prefix server",
    "dev:server": "npm run dev --prefix server",
    "start": "sh -c 'ulimit -n 65536 2>/dev/null || ulimit -n 10240 2>/dev/null; exec npx expo start'",
    "start:tunnel": "sh -c 'ulimit -n 65536 2>/dev/null || ulimit -n 10240 2>/dev/null; exec npx expo start --tunnel'",
    "start:plain": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "expo": "^54.0.0",
    "expo-camera": "~17.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-location": "~19.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.4.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.10",
    "typescript": "~5.9.2"
  }
}
